# 활용자료: 네이버 경제 뉴스 기사(2026.01.~2026.03.)

import multiprocessing
import pandas as pd
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor

#   날짜별 추출범위 및 포함 키워드 설정
TARGET_DATES = pd.date_range(start='2026-01-01', end='2026-03-31').strftime('%y%m%d').tolist()#  예시 날짜범
TARGET_KEYWORD = '005930'#  예시: 삼성전자 종목코드

def filter_str_01(file_path):
    # 모든 열에 대해 문자형태로
    df_01 = pd.read_csv(file_path, dtype=str)
    
    # '본문' 열에 키워드가 포함된 행만 필터링
    df_02 = df_01[df_01['본문'].str.contains(TARGET_KEYWORD, na=False)]
    
    return df_02

if __name__ == '__main__':
    path_001 = Path('D:/네이버뉴스/기사/경제')
    
    # file.stem: '네이버_경제_260101' 형태의 문자열 반환
    df_list_001 = [
        file for file in path_001.rglob('*.csv')
        if any(date in file.stem for date in TARGET_DATES)
    ]
    
    cl = multiprocessing.cpu_count() - 1
    
    # 병렬 처리
    with ThreadPoolExecutor(max_workers=cl) as executor:
        results = list(executor.map(filter_str_01, df_list_001))

    
    df_001 = pd.concat(results, axis=0, ignore_index=True)
    

#   상위 5개 언론사별 발행 건수 확인
publisher_cnt = df_001['언론사'].value_counts()
