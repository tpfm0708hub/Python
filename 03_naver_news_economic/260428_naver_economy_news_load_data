import multiprocessing
import pandas as pd
from pathlib import Path
from concurrent.futures import ProcessPoolExecutor

def func_read_csv(file_path):
    #   모든 열울 문자(str)로 읽음
    return pd.read_csv(file_path, dtype=str)

if __name__ == '__main__':
    #   데이터 폴더 경로 설정
    path_001 = Path('D:/네이버뉴스/기사/경제')
    #   해당 경로 내 csv 파일 목록 수집
    df_list_001 = list(path_001.rglob('*.csv'))
    
    #   병렬처리 코어 생성
    cl = multiprocessing.cpu_count() - 1
    
    #   병렬 처리 시작
    with ProcessPoolExecutor(max_workers = cl) as executor:
        #   경로 내 각 파일에 대해 func_read_csv() 일괄 적용
        results = list(executor.map(func_read_csv, df_list_001))

    #   불러온 개별 파일에 대해 하나의 데이터로 병합
    df_001 = pd.concat(results, axis = 0, ignore_index = True)
