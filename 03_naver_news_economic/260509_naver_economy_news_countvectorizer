#   텍스트 특징 추출(TF-IDF)
#   대상품사: 일반명사, 고유명사, 동사, 형용사
stnd_pos = ['NNG', 'NNP', 'VV', 'VA']
stop_words = ['삼성전자', '대비', '따르']

#   사용자 정의 tokenizer 생성
def kiwi_tokenizer(text):
    #   결측 데이터에 대해 빈 list 출력
    if pd.isna(text): return []
    
    #   분석 데이터에 대해 문자열 처리
    text = str(text)
    
    #   kiwi 형태소 분석 진행
    #   kiwi 개체: 앞서 생성된 개체 활용
    tokens = kiwi.tokenize(text)
    
    #   조건에 맞는 text 추출
    token_list = [
        token.form
        for token in tokens
        if token.tag in stnd_pos#   지정한 품사 사용
        and token.form not in stop_words#   불용어 제외
        ]
    return token_list

from sklearn.feature_extraction.text import CountVectorizer

#   CountVectorizer 통한 단어 빈도행렬 생성 준비
vectorizer = CountVectorizer(tokenizer = kiwi_tokenizer,
